{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" }
      ]
    },
    {
      "source": "/(admin|admin\\.html|klient|klient\\.html)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/klient", "destination": "/klient.html" },
    { "source": "/demo", "destination": "/demo.html" },
    { "source": "/objednat", "destination": "/objednat.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/proc-eshopy-ztraceji-zakazniky", "destination": "/blog/proc-eshopy-ztraceji-zakazniky.html" },
    { "source": "/blog/ai-zakaznicka-podpora", "destination": "/blog/ai-zakaznicka-podpora.html" },
    { "source": "/blog/emaily-ztraty-casu", "destination": "/blog/emaily-ztraty-casu.html" },
    { "source": "/blog/reklamace-email-vzory", "destination": "/blog/reklamace-email-vzory.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/favicon.ico", "destination": "/favicon.png" },
    { "source": "/favicon.png", "destination": "/favicon.png" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/kalkulacka", "destination": "/kalkulacka.html" }
  ]
}
